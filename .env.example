# Reference only: this application reads process environment variables.
# It does not automatically load a .env file.
ENTERPRISE_DB_PATH=runs/enterprise.sqlite
# Qwen/Ollama OpenAI-compatible endpoint, including /v1.
ENTERPRISE_QWEN_BASE=http://127.0.0.1:11435/v1
ENTERPRISE_QWEN_MODEL=qwen3:4b-instruct
ENTERPRISE_QWEN_KEY=
# Optional hosted OpenAI-compatible model service.
ENTERPRISE_API_BASE=
ENTERPRISE_API_MODEL=
ENTERPRISE_API_KEY=
# Policy retrieval. keyword keeps the deterministic path; hybrid and hybrid+rerank add a dense
# recall stage and an optional cross-encoder. Leave the endpoints unset to stay on keyword.
ENTERPRISE_RETRIEVAL_MODE=keyword
# Dense encoder. Either a local sentence-transformers model name, or an OpenAI-compatible
# /embeddings base URL plus its model.
ENTERPRISE_EMBED_BASE=
ENTERPRISE_EMBED_MODEL=BAAI/bge-m3
ENTERPRISE_EMBED_KEY=
ENTERPRISE_EMBED_DIMENSION=1024
# Vector store: local (in-process FAISS) or milvus.
ENTERPRISE_VECTOR_STORE=local
ENTERPRISE_MILVUS_URI=http://127.0.0.1:19530
ENTERPRISE_MILVUS_COLLECTION=enterprise_policy
ENTERPRISE_MILVUS_TOKEN=
# Cross-encoder reranker: local sentence-transformers model name, or a /rerank base URL.
ENTERPRISE_RERANK_BASE=
ENTERPRISE_RERANK_MODEL=BAAI/bge-reranker-base
ENTERPRISE_RERANK_KEY=
# Candidate depth and final result count.
ENTERPRISE_RETRIEVAL_TOP_K=20
ENTERPRISE_RETRIEVAL_TOP_N=10
# FastAPI service (enterprise-flow serve-api).
ENTERPRISEFLOW_DB=runs/enterprise.db
ENTERPRISEFLOW_MODE=fixture
ENTERPRISEFLOW_SEED=1
ENTERPRISEFLOW_TRACE=1
